  "tasks": [
    {
      "id": "T1",
      "title": "Pure finite-history evaluator and independent guarantees",
      "test": "go test -count=1 -v ./sdk/go/core -run '^TestCORE(Behavior|Ownership|Permutations)$'",
      "expect": [
        "^--- PASS: TestCOREBehavior \\(.*\\)$",
        "^--- PASS: TestCOREOwnership \\(.*\\)$",
        "^--- PASS: TestCOREPermutations \\(.*\\)$"
      ],
      "tier": "normal"
    },
    {
      "id": "T2",
      "title": "All shared CORE counter vectors",
      "test": "go test -count=1 -v ./sdk/go/core -run '^TestCOREFixtures$'",
